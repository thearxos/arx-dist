#!/usr/bin/env bash
# Resource-aware scheduler for native ARX AUR builds.
set -euo pipefail
CPU=${ARX_CPU_JOBS:-$(nproc 2>/dev/null||echo 2)}
MAX=${ARX_MAX_JOBS:-$CPU}
RAM_PER=${ARX_BUILD_RAM_MB:-1024}
MIN_DISK=${ARX_MIN_FREE_MB:-2048}
avail(){ awk '/MemAvailable:/ {print int($2/1024);exit}' /proc/meminfo 2>/dev/null||echo 0; }
disk(){ df -Pm "${1:-.}"|awk 'NR==2{print $4}'; }
jobs(){ local a d r j; a=$(avail);d=$(disk "${1:-.}");j=$CPU;[ $j -gt $MAX ]&&j=$MAX;if [ $a -gt 0 ];then r=$((a/RAM_PER));[ $r -lt $j ]&&j=$r;fi;[ $d -lt $MIN_DISK ]&&j=0;[ $j -lt 1 ]&&j=1;printf '%s\n' "$j"; }
case "${1:-}" in jobs)jobs "${2:-.}";;check)printf 'cpu=%s\nram_available_mb=%s\nfree_disk_mb=%s\nrecommended_jobs=%s\n' "$CPU" "$(avail)" "$(disk "${2:-.}")" "$(jobs "${2:-.}")";;*)echo 'usage: arx-resource-scheduler {jobs|check} [path]';exit 2;;esac
