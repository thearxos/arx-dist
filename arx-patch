#!/usr/bin/env bash
# ARX atomic self-replacement and rollback helper.
set -euo pipefail
umask 022
PREFIX=${ARX_PREFIX:-/usr/local/bin}; BACKUP=${ARX_PATCH_BACKUP:-/var/lib/arx/patch-backups}; MANIFEST=${ARX_PATCH_MANIFEST:-/var/lib/arx/patch-manifest}
usage(){ echo 'usage: arx-patch apply <file...> | rollback <file>'; }
backup(){ local d=$1 s; s=$(date +%Y%m%d-%H%M%S); mkdir -p "$BACKUP"; if [ -e "$d" ]; then cp -a -- "$d" "$BACKUP/$(basename "$d").$s"; printf '%s\t%s\n' "$d" "$BACKUP/$(basename "$d").$s">>"$MANIFEST"; fi; }
apply(){ mkdir -p "$PREFIX" "$BACKUP";touch "$MANIFEST";local src name dst tmp;for src in "$@";do name=$(basename "$src");dst="$PREFIX/$name";[ -f "$src" ]||return 1;backup "$dst";tmp=$(mktemp "$PREFIX/.arx-patch.XXXXXX");install -m 0755 "$src" "$tmp";mv -f "$tmp" "$dst";echo "> > patched $dst";done; }
rollback(){ local n=$1 l d s;l=$(grep -E "/$(printf '%s' "$n"|sed 's/[.[\*^$(){}+?|\\]/\\&/g')\.[0-9]{8}-[0-9]{6}$" "$MANIFEST"|tail -n1||true);[ -n "$l" ]||return 1;d=${l%%$'\t'*};s=${l#*$'\t'};install -m0755 "$s" "$d";echo "> > rolled back $d"; }
case "${1:-}" in apply)shift;apply "$@";;rollback)shift;rollback "$@";;*)usage;exit 2;;esac
