#!/usr/bin/env bash
# ARX Weapons resolver: repository -> BlackArch PKGBUILD -> native ARX AUR.
set -u -o pipefail
DB=${ARX_WEAPONS_DB:-/usr/share/arxos/tools.db}; CACHE=${ARX_BLACKARCH_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/arx/blackarch}; AUR=${ARX_AUR_BIN:-/usr/local/bin/arx-aur}; RAW=${ARX_BLACKARCH_RAW:-https://raw.githubusercontent.com/BlackArch/blackarch/master}
ok(){ printf '  >> %s\n' "$*"; }; installed(){ pacman -Qq "$1" >/dev/null 2>&1; }; repo_has(){ pacman -Ssq "^${1//./\\.}$" 2>/dev/null|grep -qx "$1"; }; tools(){ awk -F'|' -v s="${1^^}" '$0!~/^#/&&NF>=4&&$3==s{print $1}' "$DB" 2>/dev/null|sort -u; }
recipe(){ local p=$1 d="$CACHE/$p" t="$CACHE/.$p.tmp";mkdir -p "$CACHE";[ -f "$d/PKGBUILD" ]&&{echo "$d";return 0;};rm -rf "$t";mkdir -p "$t";curl -fsSL --retry 3 --connect-timeout 8 "$RAW/packages/$p/PKGBUILD" -o "$t/PKGBUILD"||{rm -rf "$t";return 1;};grep -q '^pkgname=' "$t/PKGBUILD"||{rm -rf "$t";return 1;};mv "$t" "$d";echo "$d";}
build(){ local p=$1 d pkg;d=$(recipe "$p")||return 1;ok "building BlackArch recipe: $p";(cd "$d"&&makepkg --syncdeps --cleanbuild --clean --needed)||return 1;pkg=$(find "$d" -maxdepth 1 -type f -name '*.pkg.tar.*' -printf '%T@ %p\n'|sort -nr|head -n1|cut -d' ' -f2-);[ -n "$pkg" ]||return 1;sudo pacman -U --needed "$pkg";}
one(){ local p=$1;installed "$p"&&{ok "$p already installed";return 0;};repo_has "$p"&&{ok "$p found in repositories";sudo pacman -S --needed "$p";return $?;};build "$p"&&return 0;[ -x "$AUR" ]&&{ok "$p not in BlackArch recipes; trying native ARX AUR";"$AUR" install "$p";return $?;};return 1;}
case "${1:-}" in install)shift;[ $# -gt 0 ]||exit 2;[ "$1" = weaponsCat ]||[ "$1" = weaponCat ]&&shift;[ $# -gt 0 ]||exit 2;if [ "$1" = full ];then mapfile -t a < <(awk -F'|' '$0!~/^#/&&NF>=1{print $1}' "$DB"|sort -u);else sub=$1;shift;mapfile -t a < <(tools "$sub");[ ${#a[@]} -gt 0 ]||a=("$sub" "$@");fi;for p in "${a[@]}";do one "$p"||exit 1;done;;*)echo 'usage: arx-weapons install [weaponsCat] <category|tool...>';exit 2;;esac
