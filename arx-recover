#!/usr/bin/env bash
set -u -o pipefail
MAX_RETRIES=${ARX_RETRIES:-3}; RETRY_BACKOFF=${ARX_RETRY_BACKOFF:-2}
JOURNAL_DIR=${ARX_JOURNAL_DIR:-/var/lib/arx/transactions}; mkdir -p "$JOURNAL_DIR" 2>/dev/null || JOURNAL_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/arx/transactions; mkdir -p "$JOURNAL_DIR"
classify(){ local f=$1; if grep -qiE 'Could not resolve host|could not resolve|Temporary failure in name resolution|Connection timed out|Connection reset|Failed to connect|Operation too slow|download.*failed|failed retrieving file|SSL.*error|curl: \([0-9]+\)' "$f"; then echo network; elif grep -qiE 'No space left on device|not enough free (disk )?space' "$f"; then echo disk; elif grep -qiE 'invalid or corrupted package|unexpected error|integrity|checksum' "$f"; then echo cache; elif grep -qiE 'key.*(unknown|expired|invalid)|invalid signature|signature.*unknown trust|required key missing' "$f"; then echo keyring; elif grep -qiE 'unable to lock database|could not lock database|database is locked' "$f"; then echo lock; elif grep -qiE 'conflicting files|conflicts with|could not satisfy dependencies|failed to prepare transaction|unable to satisfy dependency|failed to build|makepkg.*failed|configure: error|make: \*\*\*|PKGBUILD' "$f"; then echo build; elif grep -qiE 'operation failed|error:' "$f"; then echo operation; else echo unknown; fi; }
repair(){ case "$1" in network) sudo pacman -Syy --noconfirm >/dev/null 2>&1 || true;; cache) sudo pacman -Syy --noconfirm >/dev/null 2>&1 || true; sudo pacman -Sc --noconfirm >/dev/null 2>&1 || true;; keyring) sudo pacman -Sy --noconfirm archlinux-keyring >/dev/null 2>&1 || true; sudo pacman-key --populate archlinux >/dev/null 2>&1 || true;; lock) sleep 3;; dependency|operation) sudo pacman -Sy --noconfirm >/dev/null 2>&1 || true;; build|unknown) return 1;; disk) return 2;; esac; }
run(){ [ $# -gt 0 ] || return 2; local id log attempt rc kind rr backoff; id="$(date +%Y%m%d-%H%M%S)-$$"; log="$JOURNAL_DIR/$id.log"; attempt=1; backoff=$RETRY_BACKOFF; : >"$log"; while :; do exec 3>&1 4>&2; "$@" > >(tee -a "$log" >&3) 2> >(tee -a "$log" >&4); rc=$?; exec 3>&- 4>&-; [ "$rc" -eq 0 ] && return 0; kind=$(classify "$log"); [ "${ARX_DEBUG_RECOVER:-0}" = 1 ] && printf 'arx-recover: failure class: %s; journal: %s\n' "$kind" "$log" >&2; [ "$attempt" -gt "$MAX_RETRIES" ] && return "$rc"; repair "$kind"; rr=$?; [ "$rr" -eq 2 ] && return "$rc"; [ "$rr" -ne 0 ] && return "$rc"; sleep "$backoff"; backoff=$((backoff*2)); attempt=$((attempt+1)); done; }
if [ "${1:-}" = --classify ]; then shift; [ $# -eq 1 ] || exit 2; classify "$1"; else run "$@"; fi
