# ARX installer component manifest
# Keep this file declarative: install.sh owns orchestration; components own their builds.
ARX_VERSION=0.1.1
ARX_BINARY_NAME=arx
ARX_BINARY_RELEASE_PREFIX=arx-0.1.1
ARX_TARGET_X86_64=x86_64-unknown-linux-gnu

# Common required runtime foundation for both binary and source installs.
REQUIRED_RUNTIME="sudo-rs"

# Components bundled directly by the ARX release artifact.
BUNDLED_COMPONENTS="arx arx-front arx-pacman arx-core arx-aur arx-recover"

# Components that may be supplied by the ArxOS image/build rather than ARX itself.
OPTIONAL_ARXOS_COMPONENTS="arxupd arxguard arxctl arxos-askpass"

# Build-only dependencies for source mode.
SOURCE_BUILD_DEPS="base-devel rust cargo clang pkgconf git"

# GitHub release source. Override for forks/private mirrors during development.
ARX_GITHUB_REPO="thearxos/arx"
