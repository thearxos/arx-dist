#!/usr/bin/env bash
# ARX 2.2 build worker: resource-aware, journaled, package-scoped.
set -euo pipefail
CACHE=${ARX_AUR_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/arx/aur}
STATE=${ARX_AUR_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/arx/aur}
SCHED=${ARX_RESOURCE_SCHEDULER:-"$(dirname "$0")/arx-resource-scheduler"}
mkdir -p "$CACHE" "$STATE"
need(){ command -v "$1" >/dev/null 2>&1 || { echo "arx-build-worker: missing $1" >&2; exit 127; }; }
need makepkg; need flock
safe(){ [[ "$1" =~ ^[A-Za-z0-9@._+:-]+$ ]]; }
sf(){ printf '%s/%s.state' "$STATE" "$1"; }
ss(){ printf '%s\n' "$2" >"$(sf "$1")"; }
now(){ date +%s; }
mem_used_mb(){ awk '/MemAvailable:/ {a=$2} /MemTotal:/ {t=$2} END {if(t&&a) print int((t-a)/1024); else print 0}' /proc/meminfo; }
record(){ local p=$1 d=$2; printf '%s\t%s\t%s\t%s\n' "$(now)" "$p" "$(mem_used_mb)" "$(df -Pm "$d"|awk 'NR==2{print $4}')" >>"$STATE/resources.log"; }
run(){
  local p=$1 d="$CACHE/$1" jobs lock
  safe "$p" || { echo "invalid package: $p" >&2; return 2; }
  [ -f "$d/PKGBUILD" ] || { echo "$p: no PKGBUILD" >&2; return 1; }
  lock="$CACHE/.$p.build.lock"; exec 9>"$lock"; flock -n 9 || { echo "$p: already building" >&2; return 75; }
  jobs=$($SCHED jobs "$d")
  export MAKEFLAGS="-j${jobs}" NINJAFLAGS="-j${jobs}"
  ss "$p" building
  record "$p" "$d"
  cd "$d"
  makepkg --syncdeps --cleanbuild --clean --needed
  record "$p" "$d"
  ss "$p" built
}
[ "${1:-}" = build ] && { shift; [ $# -eq 1 ] || { echo 'usage: arx-build-worker build <pkg>'; exit 2; }; run "$1"; exit $?; }
echo 'usage: arx-build-worker build <pkg>' >&2; exit 2
