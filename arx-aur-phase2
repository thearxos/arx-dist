#!/usr/bin/env bash
# ARX Phase 2 native AUR transaction engine.
set -euo pipefail
CACHE=${ARX_AUR_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/arx/aur}
STATE=${ARX_AUR_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/arx/aur}
JOBS=${ARX_AUR_JOBS:-$(nproc 2>/dev/null || echo 2)}
mkdir -p "$CACHE" "$STATE"
need(){ command -v "$1" >/dev/null 2>&1 || { echo "arx-aur-phase2: missing $1" >&2; exit 127; }; }
for x in git makepkg pacman python3 flock; do need "$x"; done
safe(){ [[ "$1" =~ ^[A-Za-z0-9@._+:-]+$ ]]; }
sf(){ printf '%s/%s.state' "$STATE" "$1"; }
st(){ local f; f=$(sf "$1"); [ -f "$f" ] && cat "$f" || echo pending; }
ss(){ printf '%s\n' "$2" >"$(sf "$1")"; }
fp(){ local d=$1; { sha256sum "$d/PKGBUILD"; find "$d" -maxdepth 1 -type f ! -name 'PKGBUILD.arx-snapshot' -printf '%f\n'|sort|while read -r f;do sha256sum "$d/$f";done; makepkg --version|head -n1; uname -m; }|sha256sum|awk '{print $1}'; }
prepare(){ local p=$1 d="$CACHE/$1" t="$CACHE/.$1.tmp"; safe "$p"||return 2; exec 9>"$CACHE/.$p.lock"; flock -n 9||{ echo "$p: build already active" >&2;return 75; }; if [ -d "$d/.git" ];then git -C "$d" fetch --quiet origin master;git -C "$d" reset --hard --quiet origin/master;else rm -rf "$t";git clone --quiet --depth=1 "https://aur.archlinux.org/$p.git" "$t";mv "$t" "$d";fi;[ -f "$d/PKGBUILD" ]||return 1; printf '%s\n' "$(fp "$d")">"$d/.arx-input-fingerprint";printf '%s\n' "$d"; }
build(){ local p=$1 d state cur old; d=$(prepare "$p");state=$(st "$p");cur=$(cat "$d/.arx-input-fingerprint");old=$(cat "$d/.arx-last-built-fingerprint" 2>/dev/null||true);if [[ "$state" = installed || "$state" = built ]]&&[ "$cur" = "$old" ];then echo ":: $p: resume/no-op";return 0;fi;ss "$p" fetched;cp -f "$d/PKGBUILD" "$d/PKGBUILD.arx-snapshot";ss "$p" verified;export MAKEFLAGS="-j${JOBS}" NINJAFLAGS="-j${JOBS}";cd "$d";ss "$p" building;makepkg --syncdeps --cleanbuild --clean --needed;ss "$p" built;printf '%s\n' "$cur">"$d/.arx-last-built-fingerprint"; }
run(){ [ $# -gt 0 ]||return 2;local p pkg;for p in "$@";do build "$p";done;local -a a=();for p in "$@";do pkg=$(find "$CACHE/$p" -maxdepth 1 -type f -name '*.pkg.tar.*' -printf '%T@ %p\n'|sort -nr|head -n1|cut -d' ' -f2-);[ -n "$pkg" ]||return 1;a+=("$pkg");done;sudo pacman -U --needed "${a[@]}";for p in "$@";do ss "$p" installed;done;}
case "${1:-}" in install)shift;run "$@";;status)shift;for p in "$@";do printf '%s\t%s\n' "$p" "$(st "$p")";done;;*)echo 'usage: arx-aur-phase2 {install|status} <pkg...>';exit 2;;esac
