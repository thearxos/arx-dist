#!/usr/bin/env bash
# ARXOS front controller: native AUR routing + bounded transaction recovery.
set -u -o pipefail
REAL=/usr/local/lib/arxos/arx-pacman; AUR=/usr/local/bin/arx-aur; REC=/usr/local/bin/arx-recover
case "${1:-}" in
  aur) shift; exec "$AUR" install "$@" ;;
  install|in|i|add)
    args=("${@:2}")
    case "${args[0]:-}" in weaponsCat|weaponscat|weaponCat|weaponcat|weaponsCat-*|weaponCat-*) exec "$REC" "$REAL" "$@";; esac
    repo=() aur=()
    for p in "${args[@]}"; do
      case "$p" in -y|--yes|--noconfirm|--needed) repo+=("$p"); aur+=("$p"); continue;; esac
      # Use the local sync database for classification. This avoids turning a mirror/DNS
      # outage into a false "AUR package" decision, which would otherwise bypass recovery.
      if command -v pacman >/dev/null 2>&1 && pacman -Ssq "^${p//./\\.}$" 2>/dev/null | grep -qx "$p"; then repo+=("$p"); else aur+=("$p"); fi
    done
    if [ ${#aur[@]} -gt 0 ] && [ ${#repo[@]} -gt 0 ]; then "$REC" "$REAL" install "${repo[@]}" || exit $?; exec "$REC" "$AUR" install "${aur[@]}"; fi
    [ ${#aur[@]} -gt 0 ] && exec "$REC" "$AUR" install "${aur[@]}"
    exec "$REC" "$REAL" "$@";;
  remove|rm|r|del|uninstall|update|up|upgrade|sync|syu|system|sys|sysupgrade|tools|self|selfupdate|self-update|weapons|arsenal|w) exec "$REC" "$REAL" "$@" ;;
  *) exec "$REAL" "$@" ;;
esac
